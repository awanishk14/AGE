# ─────────────────────────────────────────────
# AGE (Adaptive Growth Engine) — environment example
# Copy to .env and fill in real values. Never commit .env.
# ─────────────────────────────────────────────

# Runtime
NODE_ENV=development

# Web (Next.js)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# API (NestJS)
API_PORT=4000

# PostgreSQL
POSTGRES_USER=age
POSTGRES_PASSWORD=age
POSTGRES_DB=age
DATABASE_URL=postgresql://age:age@localhost:5432/age?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# AI / LLM (model-agnostic OpenAI-compatible)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AGE_DEFAULT_MODEL=gpt-4o-mini
