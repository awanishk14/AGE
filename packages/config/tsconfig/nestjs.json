{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "@age/config nestjs",
  "extends": "./base.json",
  "compilerOptions": {
    "composite": false,
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2022",
    "lib": ["ES2022"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false,
    "outDir": "./dist",
    "noEmit": false,
    "verbatimModuleSyntax": false
  }
}
