{
  "name": "@age/persistence",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:db": "vitest run --config vitest.db.config.ts",
    "typecheck:db": "tsc -p tsconfig.db.json --noEmit",
    "prisma:validate": "prisma validate --schema src/prisma/schema.prisma",
    "prisma:generate": "prisma generate --schema src/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema src/prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema src/prisma/schema.prisma",
    "prisma:migrate:diff": "prisma migrate diff --from-empty --to-schema-datamodel src/prisma/schema.prisma --script",
    "prisma:migrate:status": "prisma migrate status --schema src/prisma/schema.prisma",
    "prisma:migrate:drift": "prisma migrate diff --from-url $DATABASE_URL --to-schema-datamodel src/prisma/schema.prisma --exit-code",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@age/business-knowledge-graph": "workspace:*",
    "@age/shared": "workspace:*"
  },
  "devDependencies": {
    "@age/business-discovery-contracts": "workspace:*",
    "@age/capture": "workspace:*",
    "@age/scored-bif-snapshot-persistence": "workspace:*",
    "@age/session-store": "workspace:*",
    "@age/session-store-persistence": "workspace:*",
    "@age/source-observation": "workspace:*",
    "@prisma/client": "^5.20.0",
    "prisma": "^5.20.0",
    "vitest": "^2.1.1"
  }
}
