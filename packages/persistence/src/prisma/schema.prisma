// AGE persistence — Prisma schema (Task 005)
//
// Datasource + generator configuration ONLY.
// No models, no tables, no migrations are defined yet — the canonical model is
// the Business Knowledge Graph; PostgreSQL persists it in a later task.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
