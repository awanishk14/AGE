// AGE persistence — Prisma schema.
//
// This file is the SINGLE SCHEMA OF RECORD for the scored BIF snapshot path
// (ADR-0031 Decision 3). A second active schema source for this path is not
// permitted. The `HealthCheck` placeholder under `apps/api` is not a second
// source of truth and gains nothing from this file.
//
// The Business Knowledge Graph is still unmodelled here; the only table below
// is the scored BIF snapshot store.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// ScoredBifSnapshot — the durable, IMMUTABLE, APPEND-ONLY store for scored BIF
/// snapshots (ADR-0029 stage 3, ADR-0030 identity and lifecycle, ADR-0031
/// Decisions 4, 6, 7, 9, 10, 11).
///
/// APPEND-ONLY IS ENFORCED BY WHAT IS ABSENT. There is deliberately no
/// `updatedAt`, no `version`, and no `deletedAt` column, and no mutable
/// `current`/`isCurrent` flag. A row carrying an `updatedAt` invites an update;
/// a row that cannot express "when it was changed" cannot be changed without
/// the change being obvious. Grant-level enforcement (INSERT/SELECT only, no
/// UPDATE, no DELETE) and RLS on `organizationId` are authored in a later
/// slice — they are additional locks on this door, not the design of it.
///
/// IDENTITY IS COMPOSITE AND CALLER-SUPPLIED. The primary key is
/// (clientId, organizationId, bifId, snapshotId). There is no surrogate id:
/// the logical identity IS the key. `clientId` and `organizationId` are the
/// scope, taken from the caller's `ClientContext` (ADR-0009) and never inferred
/// from the snapshot payload; `bifId` is the subject; `snapshotId` names one
/// member of the series. Re-using a `snapshotId` within a series is rejected by
/// the primary key itself, not merely by adapter code.
///
/// `scoringVersion` is an ATTRIBUTE, never part of the key — keying on it would
/// forbid re-scoring a BIF twice under one scoring version, which is normal.
/// It is nullable because `ScoredBifContext.scoringVersion` is optional; a
/// snapshot projected without scoring metadata is not invalid.
///
/// TIME IS A STRING, ON PURPOSE (ADR-0031 D10). `capturedAt` is stored as the
/// exact canonical ISO-8601 UTC instant the caller supplied
/// (`YYYY-MM-DDTHH:mm:ss.sssZ`). A `timestamptz` round trip would be permitted
/// only if it returned that byte-identical string; `text` guarantees it, and
/// because the format is fixed-width UTC, lexicographic order already agrees
/// with chronological order — so "latest" is an ORDER BY, not a parse.
///
/// `context` is ONE jsonb column, not shredded into section tables: shredding
/// would make every projection change a migration, and would tempt someone to
/// materialise omitted sections as null rows — which ADR-0026 Decision 4
/// forbids, since absence is a limitation and never negative evidence.
///
/// NOT STORED: the live BIF, BIF `status` as a queryable column, recomputed
/// scores, server-generated time (there is no `DEFAULT now()` anywhere here),
/// and no foreign key to clients or organizations — this table is owned by the
/// snapshot boundary alone.
model ScoredBifSnapshot {
  clientId        String  @map("client_id")
  organizationId  String  @map("organization_id")
  bifId           String  @map("bif_id")
  snapshotId      String  @map("snapshot_id")
  capturedAt      String  @map("captured_at")
  snapshotVersion String  @map("snapshot_version")
  scoringVersion  String? @map("scoring_version")
  context         Json

  @@id([clientId, organizationId, bifId, snapshotId])
  @@index([clientId, organizationId, bifId, capturedAt(sort: Desc), snapshotId(sort: Desc)], map: "scored_bif_snapshots_series_latest_idx")
  @@map("scored_bif_snapshots")
}

/// OperatorSession — the session-store rows (ADR-0061 A2, ADR-0068 §0.1b).
///
/// THIS IS THE ONE SCHEMA CROSSING ADR-0068 LOWERED, AND ONLY THIS STORE. It
/// authorized "the session-store rows: model, migration and RLS" and nothing
/// else; a second table arriving beside this one is a different decision and
/// needs its own ADR.
///
/// AGE NEVER ISSUES A SESSION. Provisioning the second operator is an ACT
/// performed out of band (ADR-0068 §0.1c refuses every provisioning surface by
/// name), so this table is written by an operator with a database client and
/// read by AGE. That is why the migration grants SELECT and nothing else:
/// verification is not issuance, and a store AGE can only read cannot become an
/// issuance path by someone adding one function.
///
/// THE RAW TOKEN IS NOT HERE. `tokenHash` is a SHA-256 digest and the column is
/// unique, so one token identifies at most one session; a database dump yields
/// no usable session. The reason the digest may be fast rather than argon2id is
/// the token's 256 bits of entropy — see `@age/session-store`.
///
/// NO ROLE, NO `isAdmin`, NO PERMISSION LIST (ADR-0062 D3). Admin is never a
/// bypass, and a column is how a bypass arrives: the check that reads it is
/// added later, by someone who did not read the ADR. A session says WHO is
/// asking; what they may do is `askEntitlement`.
///
/// TIME IS A STRING, for the reason ScoredBifSnapshot gives above: the caller's
/// exact canonical ISO-8601 UTC instant, byte-identical on the way back, with
/// lexicographic order already agreeing with chronological order. There is no
/// `DEFAULT now()` anywhere here — a row that timestamps itself is a row the
/// database issued.
///
/// `expiresAt` IS NOT NULLABLE. There is no "never expires": an absolute expiry
/// is the one control that still works when nobody notices a session was
/// stolen (ADR-0068's A1). `revokedAt` is nullable because "not revoked" is a
/// real state, and revocation is never expressed by deleting the row.
/// `organizationId` IS NULLABLE, AND THAT IS ADR-0082 D1 IN ONE COLUMN. The
/// Product Owner decided a platform operator's session carries "no organisation
/// id", so a platform session stores NULL rather than a reserved literal. NULL
/// never equals anything, which is why every tenant policy keeps matching
/// exactly the rows it matched before; a sentinel string would equal things, and
/// every tenant policy would then treat the platform operator as a real-but-
/// empty tenant. AN ABSENT ORGANIZATION IS A FACT ABOUT THE SESSION, NOT A
/// MISSING VALUE: no reader may default, coalesce or render it as a tenant, and
/// one that finds NULL where it expected a tenant refuses (ADR-0082 D4).
model OperatorSession {
  sessionId      String  @id @map("session_id")
  organizationId String? @map("organization_id")
  accountId      String  @map("account_id")
  tokenHash      String  @unique(map: "operator_sessions_token_hash_key") @map("token_hash")
  issuedAt       String  @map("issued_at")
  expiresAt      String  @map("expires_at")
  revokedAt      String? @map("revoked_at")

  @@index([organizationId], map: "operator_sessions_organization_idx")
  @@map("operator_sessions")
}

/// Account — WHO EXISTS (ADR-0079 slice 2 of §6).
///
/// AN IDENTITY, AND DELIBERATELY NOTHING ELSE. There is no credential column
/// here and there is not going to be one: AGE's own code never compares a
/// password (ADR-0061 A2), and ADR-0079 D3 — whether Google sign-in covers all
/// three scopes or staff only — is still the owner's and is unanswered. A
/// `passwordHash` field added "for later" is a field something eventually
/// writes to.
///
/// NO ROLE HERE EITHER. What an account may reach is an `AccountMembership`,
/// because the same person can be an agency operator in one organization and
/// nothing at all in another. A role on the account would be a role everywhere,
/// which is exactly the widening ADR-0079 §2 keeps out of the model.
///
/// AGE CANNOT CREATE ONE. The table holds `GRANT SELECT` and nothing else:
/// issuing a SESSION is what ADR-0079 §3 overturned, and provisioning an
/// ACCOUNT remains a human act performed out of band. `disabledAt` is how an
/// account stops being usable; the row is never deleted, for the same reason a
/// revoked session is not.
model Account {
  accountId   String  @id @map("account_id")
  email       String  @unique(map: "accounts_email_key")
  displayName String  @map("display_name")
  createdAt   String  @map("created_at")
  disabledAt  String? @map("disabled_at")

  @@map("accounts")
}

/// AccountMembership — WHAT AN ACCOUNT MAY REACH, read per request.
///
/// SCOPE IS READ FROM THE DATABASE, NEVER FROM THE CREDENTIAL (ADR-0079 §2).
/// The session carries no role, no `isAdmin` and no permission list (ADR-0062
/// D3); it says who is asking, and this table says what that means today. A
/// membership revoked a minute ago is therefore effective on the next request
/// rather than at the next sign-in.
///
/// THE THREE SHAPES ARE ENFORCED BY A CHECK CONSTRAINT, not by this file.
/// Prisma cannot express "a client membership must name a client and an agency
/// membership must not", so the migration writes the constraint by hand and the
/// live suite proves it rejects each malformed shape. A client membership that
/// forgot its `clientId` would be an agency-wide membership wearing the word
/// "client".
///
/// A PLATFORM MEMBERSHIP HAS A NULL `organizationId`, WHICH IS WHY IT IS
/// INVISIBLE TO EVERY SCOPED READ. The RLS policy compares equality, and
/// nothing equals NULL — so no tenant can discover that platform operators
/// exist. `roleBundle` names a bundle from `@age/access-scope`; it is resolved
/// to capability atoms once, at scope construction, and 🚫 no decision is ever
/// taken against the name.
model AccountMembership {
  membershipId   String  @id @map("membership_id")
  accountId      String  @map("account_id")
  scopeKind      String  @map("scope_kind")
  organizationId String? @map("organization_id")
  clientId       String? @map("client_id")
  roleBundle     String  @map("role_bundle")
  createdAt      String  @map("created_at")
  revokedAt      String? @map("revoked_at")

  @@index([organizationId], map: "account_memberships_organization_idx")
  @@map("account_memberships")
}

/// SourceObservation — what an external system OBSERVED (ADR-0069 §6, deliverable 2).
///
/// THE THIRD CATEGORY, AND IT IS NOT THE OTHER TWO. A row here is neither what
/// the business says (that is the BIF) nor what AGE concludes (that is derived,
/// and ADR-0069 D2 says it is COMPUTED and therefore has no table at all). This
/// store holds only what a peer product asserted it saw.
///
/// A ROW IS A CANDIDATE, PERMANENTLY (ADR-0069 D5). SOURCE ARRIVAL IS NEVER
/// CONFIRMATION, which is why there is deliberately no `status`, no `confirmed`,
/// no `accepted`, no `dismissed`, no `weight`, no `trust`, no `score` and no
/// `confidence` column. Each of those would be a way for an inbound observation
/// to promote itself, and the first thing anyone does with such a column is read
/// it as agreement.
///
/// APPEND-ONLY, ENFORCED BY WHAT IS ABSENT, exactly as `ScoredBifSnapshot` is:
/// no `updatedAt`, no `version`, no `deletedAt`, no mutable `current` flag. A
/// source that observed something different next month sends a NEW observation
/// with a new period; it does not edit last month's. Correcting history is how a
/// record of what was believed at the time gets destroyed.
///
/// THE TENANT IS THE ORGANIZATION, AND THERE IS NO `client_id` (ADR-0062 D1/D2).
/// This matches `operator_sessions` and deliberately not `scored_bif_snapshots`:
/// an observation is scoped by whose business it is about, and a client is a
/// SUBJECT rather than a principal. The absence also keeps ADR-0066 D7 uncrossed
/// BY SHAPE — an inbound path that cannot name a client cannot be pointed at
/// one.
///
/// SUBJECT IS THREE COLUMNS BECAUSE IT IS TWO SHAPES. `subject_disposition` is
/// `modelled` or `unmapped`. For `modelled`, `subject_kind` is present and
/// `subject_label` is AGE'S OWN label for the subject, so two sources spelling a
/// service differently converge on one subject. For `unmapped`, `subject_kind`
/// is NULL — 🚫 NOT a guessed kind — and `subject_label` is the raw topic. An
/// unmapped row is retained precisely because AGE could not relate it: that is
/// the finding, and a NULL kind is what stops a later query from silently
/// counting it as coverage.
///
/// NO RAW CORPUS, EVER. `source_record_id` is a REFERENCE back into the source
/// system, which keeps its own 50,000 rows. AGE stores the reference, never the
/// corpus, and there is no payload/body/raw column for one to arrive in.
///
/// TIME IS A STRING and there is NO `DEFAULT now()`, for the reason the two
/// models above give. `recorded_at` is supplied by the caller and is NOT
/// `observed_at`: an operator-mediated relay happens days after the observation
/// BY CONSTRUCTION, and collapsing the two would make every relayed observation
/// look freshly made.
model SourceObservation {
  observationId      String  @id @map("observation_id")
  organizationId     String  @map("organization_id")
  sourceSystem       String  @map("source_system")
  sourceInstance     String  @map("source_instance")
  sourceRecordId     String  @map("source_record_id")
  subjectDisposition String  @map("subject_disposition")
  subjectKind        String? @map("subject_kind")
  subjectLabel       String  @map("subject_label")
  claimDirection     String  @map("claim_direction")
  claimMateriality   String  @map("claim_materiality")
  claimKind          String  @map("claim_kind")
  observedAt         String  @map("observed_at")
  windowStart        String  @map("window_start")
  windowEnd          String  @map("window_end")
  recordedAt         String  @map("recorded_at")

  @@index([organizationId, observedAt(sort: Desc), observationId(sort: Desc)], map: "source_observations_organization_observed_idx")
  @@map("source_observations")
}
