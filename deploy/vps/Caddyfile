# The terminator (ADR-0061 A6 item 1).
#
# ⚠️ TLS is terminated HERE and nowhere else. Caddy obtains and renews the
# certificate itself, so 🚫 there is no manual expiry to forget.
#
# ⚠️ Plaintext is not served — it is redirected before anything is read, and the
# app behind still refuses a request whose forwarded protocol is not `https`
# (`acceptForwardedTransport`). Two independent statements of the same rule, on
# purpose: the redirect is a courtesy, the refusal is the boundary.
#
# 🛑 THE UPSTREAMS ARE THE DEMO, 🚫 NOT AGE STUDIO (ADR-0061 §5-A/§5-B).
# ⚠️ Both are INTERNAL SERVICE NAMES on the composition's own network:
# 🚫 never a published port, 🚫 never an address on this host, 🚫 never a name
# a client supplies.

{$AGE_PUBLIC_HOST} {
	encode gzip

	# ⚠️ `/api/*` is stripped before it reaches the API, so the browser's
	# same-origin `/api/demo/capabilities` arrives as `/demo/capabilities`.
	# 🚫 The API is not otherwise reachable: it publishes no port of its own.
	handle_path /api/* {
		reverse_proxy api:4000 {
			header_up X-Forwarded-Proto https
		}
	}

	# ⚠️ `X-Forwarded-Proto` is set HERE, on every request, overwriting whatever
	# the client sent. 🚫 It is never passed through: a client-supplied value is
	# a claim, not evidence.
	handle {
		reverse_proxy web:3000 {
			header_up X-Forwarded-Proto https
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

http://{$AGE_PUBLIC_HOST} {
	redir https://{host}{uri} permanent
}
