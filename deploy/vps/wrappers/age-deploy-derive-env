#!/bin/bash
#
# ADR-0077 D3 wrapper 2 of 4 — derive the container's env file.
#
# 🛑 REPLACES `sudo sh -c "sed … > …"`, WHICH IS A ROOT SHELL AND NOT AN
# OPERATION. The substitution and both paths are literals here: a caller-supplied
# `sed` expression, or a caller-supplied output path, is an arbitrary root write.
#
# 🚫 THE VALUE IS NEVER PRINTED, ECHOED, LOGGED OR RETURNED (ADR-0076 D6).

set -euo pipefail

if [ "$#" -ne 0 ]; then
  echo "REFUSED: ${0} takes no arguments; it was given $#." >&2
  exit 2
fi

SOURCE='/etc/age-studio/age-studio.env'
DERIVED='/etc/age-studio/age-studio.container.env'
SECRET_DIR='/etc/age-studio'
OWNER='age-deploy'

if [ ! -f "$SOURCE" ]; then
  echo "REFUSED: the provisioned env file does not exist." >&2
  echo "  Run scripts/provision-studio-database.sh first. Nothing is generated here." >&2
  exit 2
fi

# 🛑 **THIS NO LONGER REWRITES ANYTHING** — ADR-0078 C3.
#
# ⚠️ **WHAT IT USED TO DO, AND WHY IT STOPPED.** Until C3 the provisioned file
# named AGE's HOST PUBLICATION, and this step substituted
# `@127.0.0.1:5442/` → `@172.23.0.2:5432/` because that publication does not
# exist inside the container's namespace. C3 removed the publication, so
# `provision-studio-database.sh` now writes the container route directly and
# there is nothing left to substitute. 🚫 A substitution kept "just in case"
# would be a rule nobody can test — the pattern would never match, and its
# silence would read as success.
#
# 🛑 **THE VERIFICATION BELOW IS WHAT CARRIES THE WEIGHT NOW**, and it is why
# this remains a derive step rather than a symlink: the container's env file must
# be separately owned and separately checked, and a source file that predates C3
# must FAIL here rather than start a console pointed at a port that is gone.
cp "$SOURCE" "$DERIVED"
chmod 600 "$DERIVED"

# ⚠️ THE DEPLOY USER, 🚫 NOT root. `docker compose` reads `env_file` on the
# CLIENT side, as the invoking user. 600 still means no other account on this
# shared host can read the database URL, which is what D6 requires.
chown "${OWNER}:${OWNER}" "$DERIVED"
chgrp "$OWNER" "$SECRET_DIR"
chmod 750 "$SECRET_DIR"

if ! grep -q '@172.23.0.2:5432/' "$DERIVED"; then
  echo "REFUSED: the derived env file does not name the container route." >&2
  echo "  Since ADR-0078 C3 the provisioned DATABASE_URL must already address" >&2
  echo "  the container route; a file naming a host port predates C3." >&2
  echo "  Re-run scripts/provision-studio-database.sh. 🚫 Nothing is rewritten here." >&2
  exit 2
fi

echo "    (derived, 600, deploy-user-owned — value never printed)"
