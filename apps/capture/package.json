{
  "name": "@age/capture",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "age-capture": "./dist/bin/age-capture.cjs"
  },
  "exports": {
    ".": "./src/index.ts",
    "./composition": "./src/capture-composition.ts",
    "./deployed-composition": "./src/deployed-console-composition.ts",
    "./deployed-scope-composition": "./src/deployed-scope-composition.ts",
    "./deployed-session-composition": "./src/deployed-session-composition.ts",
    "./deployed-sign-in-composition": "./src/deployed-sign-in-composition.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/bundle.mjs",
    "bundle": "node scripts/bundle.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@age/business-discovery-capture": "workspace:*",
    "@age/business-discovery-contracts": "workspace:*",
    "@age/capability-intelligence": "workspace:*",
    "@age/capability-kit": "workspace:*",
    "@age/capability-market-discovery": "workspace:*",
    "@age/capability-revenue": "workspace:*",
    "@age/client-context-projection": "workspace:*",
    "@age/client-registry": "workspace:*",
    "@age/deployed-database-target": "workspace:*",
    "@age/discovery-answer-file": "workspace:*",
    "@age/observation-association": "workspace:*",
    "@age/operator-file-policy": "workspace:*",
    "@age/scored-bif-snapshot-persistence": "workspace:*",
    "@age/session-issuance-persistence": "workspace:*",
    "@age/session-store": "workspace:*",
    "@age/session-store-persistence": "workspace:*",
    "@age/sign-in-directory": "workspace:*",
    "@age/sign-in-directory-persistence": "workspace:*",
    "@age/source-observation": "workspace:*",
    "@age/source-observation-persistence": "workspace:*",
    "@prisma/client": "^5.20.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "ts-loader": "^9.5.1",
    "vitest": "^2.1.1",
    "webpack": "^5.97.1",
    "webpack-node-externals": "^3.0.0"
  }
}
