{
  "name": "@age/api",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "nest start --webpack --webpackPath webpack.config.js --watch",
    "build": "nest build --webpack --webpackPath webpack.config.js",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "smoke:demo": "node scripts/smoke-demo.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@age/demo-runtime": "workspace:*",
    "@age/integrations": "workspace:*",
    "@age/knowledge": "workspace:*",
    "@age/shared": "workspace:*",
    "@age/types": "workspace:*",
    "@nestjs/common": "^10.4.4",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-express": "^10.4.4",
    "@prisma/client": "^5.20.0",
    "ioredis": "^5.4.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@playwright/test": "^1.47.2",
    "@types/express": "^5.0.0",
    "prisma": "^5.20.0",
    "ts-loader": "^9.5.1",
    "vitest": "^2.1.1"
  }
}
