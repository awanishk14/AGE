{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "api",
  "projectType": "application",
  "sourceRoot": "apps/api/src",
  "tags": ["scope:api", "type:app"],
  "targets": {
    "build": { "command": "nest build", "options": { "cwd": "apps/api" } },
    "dev": { "command": "nest start --watch", "options": { "cwd": "apps/api" } },
    "typecheck": { "command": "tsc -p tsconfig.json --noEmit", "options": { "cwd": "apps/api" } },
    "lint": { "command": "eslint .", "options": { "cwd": "apps/api" } },
    "test": { "command": "vitest run --passWithNoTests", "options": { "cwd": "apps/api" } },
    "test:e2e": { "command": "playwright test", "options": { "cwd": "apps/api" } }
  }
}
