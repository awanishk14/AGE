{
  "name": "@age/mcp",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "./src/mcp-protocol.ts",
  "types": "./src/mcp-protocol.ts",
  "bin": {
    "age-mcp": "./dist/bin/age-mcp.cjs"
  },
  "scripts": {
